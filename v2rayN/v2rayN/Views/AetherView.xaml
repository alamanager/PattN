<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.AetherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="700"
    d:DesignWidth="520"
    x:TypeArguments="vms:AetherViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Key="PulseRing" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="pulseRing"
                Storyboard.TargetProperty="(Ellipse.RenderTransform).(ScaleTransform.ScaleX)"
                From="0.85"
                To="1.12"
                Duration="0:0:2.4" />
            <DoubleAnimation
                Storyboard.TargetName="pulseRing"
                Storyboard.TargetProperty="(Ellipse.RenderTransform).(ScaleTransform.ScaleY)"
                From="0.85"
                To="1.12"
                Duration="0:0:2.4" />
            <DoubleAnimation
                Storyboard.TargetName="pulseRing"
                Storyboard.TargetProperty="Opacity"
                From="0.55"
                To="0.0"
                Duration="0:0:2.4" />
        </Storyboard>
        <Storyboard x:Key="EnterCard0">
            <DoubleAnimation
                BeginTime="0:0:0"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.35" />
        </Storyboard>
        <Storyboard x:Key="EnterCard1">
            <DoubleAnimation
                BeginTime="0:0:0.07"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.35" />
        </Storyboard>
        <Storyboard x:Key="EnterCard2">
            <DoubleAnimation
                BeginTime="0:0:0.14"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.35" />
        </Storyboard>
        <Storyboard x:Key="EnterCard3">
            <DoubleAnimation
                BeginTime="0:0:0.21"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.35" />
        </Storyboard>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseRing}" />
        </EventTrigger>
    </UserControl.Triggers>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Margin8}">
            <materialDesign:Card
                Margin="{StaticResource Margin4}"
                Padding="20,16"
                materialDesign:ElevationAssist.Elevation="Dp4">
                <materialDesign:Card.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource EnterCard0}" />
                    </EventTrigger>
                </materialDesign:Card.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="112"
                        Height="112"
                        Margin="0,0,16,0">
                        <Ellipse
                            x:Name="pulseRing"
                            Stroke="#22C55E"
                            StrokeThickness="2"
                            RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#1E3A5F" />
                                    <GradientStop Offset="1" Color="#0F172A" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <materialDesign:PackIcon
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#22C55E"
                            Kind="Power" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="17"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Aether" />
                        <TextBlock
                            x:Name="txtStatus"
                            Margin="0,4,0,4"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="txtEndpoints"
                            FontFamily="Consolas"
                            FontSize="11"
                            TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button
                                x:Name="btnConnect"
                                MinWidth="120"
                                Margin="0,0,8,0"
                                Content="{x:Static resx:ResUI.AetherConnect}"
                                Style="{StaticResource DefButton}" />
                            <Button
                                x:Name="btnDisconnect"
                                MinWidth="120"
                                Content="{x:Static resx:ResUI.AetherDisconnect}"
                                Style="{StaticResource DefButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <GroupBox
                Margin="{StaticResource Margin4}"
                Header="Transport"
                Style="{StaticResource MyGroupBox}">
                <GroupBox.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource EnterCard1}" />
                    </EventTrigger>
                </GroupBox.Triggers>
                <StackPanel>
                    <ComboBox
                        x:Name="cmbProtocol"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="Protocol"
                        Style="{StaticResource DefComboBox}" />
                    <ComboBox
                        x:Name="cmbScanMode"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="Scan mode"
                        Style="{StaticResource DefComboBox}" />
                    <ComboBox
                        x:Name="cmbExtraTransport"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="Extra transport (Tor / Psiphon)"
                        Style="{StaticResource DefComboBox}" />
                    <CheckBox
                        x:Name="togTorBridges"
                        Margin="{StaticResource Margin4}"
                        Content="Tor: straight to bridges" />
                    <ComboBox
                        x:Name="cmbPsiphonRegion"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="Psiphon exit region (empty = automatic)"
                        IsEditable="True"
                        Style="{StaticResource DefComboBox}" />
                    <ComboBox
                        x:Name="cmbPsiphonMode"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="Psiphon shape"
                        Style="{StaticResource DefComboBox}" />
                </StackPanel>
            </GroupBox>

            <GroupBox
                Margin="{StaticResource Margin4}"
                Header="Network"
                Style="{StaticResource MyGroupBox}">
                <GroupBox.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource EnterCard2}" />
                    </EventTrigger>
                </GroupBox.Triggers>
                <StackPanel>
                    <ComboBox
                        x:Name="cmbIpVersion"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="IP version"
                        Style="{StaticResource DefComboBox}" />
                    <CheckBox
                        x:Name="togMasqueHttp2"
                        Margin="{StaticResource Margin4}"
                        Content="MASQUE over HTTP/2 (TCP)" />
                    <ComboBox
                        x:Name="cmbMasqueNoize"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="MASQUE obfuscation"
                        Style="{StaticResource DefComboBox}" />
                    <ComboBox
                        x:Name="cmbWgNoize"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="WireGuard obfuscation"
                        Style="{StaticResource DefComboBox}" />
                    <TextBox
                        x:Name="txtBindAddress"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="SOCKS5 listen address"
                        Style="{StaticResource DefTextBox}" />
                    <TextBox
                        x:Name="txtUpstream"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="Upstream proxy to chain through (optional)"
                        Style="{StaticResource DefTextBox}" />
                    <TextBox
                        x:Name="txtDns"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="Tunnel DNS (optional)"
                        Style="{StaticResource DefTextBox}" />
                    <CheckBox
                        x:Name="togQuickReconnect"
                        Margin="{StaticResource Margin4}"
                        Content="Quick reconnect" />
                </StackPanel>
            </GroupBox>

            <GroupBox
                Margin="{StaticResource Margin4}"
                Header="System proxy"
                Style="{StaticResource MyGroupBox}">
                <GroupBox.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource EnterCard3}" />
                    </EventTrigger>
                </GroupBox.Triggers>
                <StackPanel>
                    <CheckBox
                        x:Name="togSysProxy"
                        Margin="{StaticResource Margin4}"
                        Content="Route Windows through the Aether HTTP endpoint" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
